# Cache rules for Cloudflare Workers static assets.
# Order matters: later, more specific rules override earlier ones.
# NOTE: /assets/art/*, /assets/collections/*, /assets/scripts/* and
# /assets/tokens/* are served by the Worker (R2 first), which sets its own
# Cache-Control — rules here only apply to files served from the repo.

# HTML / CSS / JS: always revalidate so edits show on a normal refresh
/*.html
  Cache-Control: no-cache, must-revalidate
/assets/*.css
  Cache-Control: no-cache, must-revalidate
/assets/*.js
  Cache-Control: no-cache, must-revalidate

# Character art & other repo images: revalidate so updated art shows immediately.
# NOTE: a request carrying a `?v=` stamp is answered by the Worker with a real
# max-age instead (ART_VERSIONED_CACHE in worker.js) — every card grid on the
# wiki asks that way now, because these paths run the Worker and a revalidation
# is an invocation even when it ends in a 304. Rules here cannot match on a
# query string, which is why that override lives in the Worker and not below.
/assets/*.png
  Cache-Control: no-cache, must-revalidate
/assets/*.jpg
  Cache-Control: no-cache, must-revalidate
/assets/art/*
  Cache-Control: no-cache, must-revalidate

# Official role icons never change — cache long
/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts rarely change and are large — cache long
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pyodide runtime + wheels (Token Tool): pinned version, contents never change
/assets/pyodide/*
  Cache-Control: public, max-age=31536000, immutable

# Token toolkit files: fetched with a ?v= from the manifest, safe to cache long
/assets/tokens/*
  Cache-Control: public, max-age=31536000, immutable

# The token manifest must always be fresh (it carries the version)
/assets/tokens/manifest.json
  Cache-Control: no-cache, must-revalidate

# Bundled official-character dataset (import resolution): revalidate so a
# refreshed roles list shows without a long cache wait
/assets/roles.json
  Cache-Control: no-cache, must-revalidate

# Official night-order positions (the "acts directly after" picker): same
/assets/night-order.json
  Cache-Control: no-cache, must-revalidate

# Icon Forge's fixed payload: the texture sheets and the vendored editor.
# Pinned content that only changes when it is deliberately replaced, and heavy
# (the editor bundle alone is 1.4 MB), so cache it hard.
#
# Two things are deliberately NOT here. The tool's own modules
# (assets/iconforge/*.js) keep the revalidate-every-load rule above, so an
# edit shows on a normal refresh like every other script on the site. And
# assets/iconforge/vendor/* is left on that rule too: those files carry a
# small local patch (see vendor/README.md), and a year-long immutable cache
# would strand anyone who already has the old copy if that patch ever
# changes. They are ~220 KB and only load for Smart remove.
/assets/iconforge/textures/*
  Cache-Control: public, max-age=31536000, immutable
/assets/iconforge/minipaint/*
  Cache-Control: public, max-age=31536000, immutable
